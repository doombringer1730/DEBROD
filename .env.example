# Copy to .env.local for local development, or add each one in Vercel →
# Project → Settings → Environment Variables. Never commit real values.

# Required. The password for the login page. Changing it signs everyone out.
SITE_PASSWORD=

# Required. TMDB v3 API key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# At least one debrid account. Results from both are merged.
# https://real-debrid.com/apitoken
REALDEBRID_API_KEY=
# TorBox → Settings → API key
TORBOX_API_KEY=

# Optional: watch together. From your Supabase project → Project Settings → API.
# Realtime only; no tables needed.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional.
# SITE_NAME=DEBROD
# TORRENTIO_URL=https://torrentio.strem.fun
